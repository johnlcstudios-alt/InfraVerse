<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>IndustrialDigitalTwinSimulator</RootNamespace>
    <AssemblyName>IndustrialDigitalTwinSimulator</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Industrial Digital Twin Simulator</AssemblyTitle>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Version>1.0.0</Version>
    <Product>Industrial Digital Twin Simulator</Product>
    <Company>3DInfra</Company>
    <Description>Native Windows desktop shell for the Industrial Digital Twin Simulator web application.</Description>
    <Copyright>Copyright (c) 3DInfra</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies allow SDK-style net48 builds without the Visual
         Studio .NET Framework targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\app.ico" LogicalName="IndustrialDigitalTwinSimulator.app.ico" />
  </ItemGroup>

</Project>
